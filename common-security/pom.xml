<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.appfleet</groupId>
    <artifactId>appfleet-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>common-security</artifactId>
  <packaging>jar</packaging>

  <!-- A library, not a service: JWT validation filter + SecurityContext
       plumbing. Every service validates locally with the RSA public key —
       no network call to identity-service to authenticate. -->
  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-oauth2-jose</artifactId>
    </dependency>
    <dependency>
      <groupId>io.appfleet</groupId>
      <artifactId>common-events</artifactId>
      <version>${project.version}</version>
    </dependency>
  </dependencies>
</project>
